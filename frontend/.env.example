# Copy to .env for local dev (frontend/.env or the repo-root .env), and set the same
# names in Vercel > Project > Settings > Environment Variables. Never commit real values.
# Deliberately NOT prefixed REACT_APP_ — that prefix would bundle them into the public site.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written for you by `npm run spotify:auth`
SPOTIFY_REFRESH_TOKEN=
# Optional: only if you registered a different loopback Redirect URI than the default
# http://127.0.0.1:8888/callback
# SPOTIFY_REDIRECT_URI=
